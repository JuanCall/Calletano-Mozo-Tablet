{
  "expo": {
    "name": "POS-Mozo",
    "slug": "mozo-tablet",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./app/assets/images/icon.png",
    "scheme": "mozotablet",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#120B06",
        "foregroundImage": "./app/assets/images/icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.juanoffx.mozotablet",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./app/assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./app/assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#120B06",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "./plugins/with-network-security-config",
      "expo-font",
      "expo-dev-client",
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir a Calletano usar la cámara para escanear el QR del Club de clientes."
        }
      ],
      [
        "expo-navigation-bar",
        {
          "hidden": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "714a207d-ebeb-4389-b9f4-bf8f39f9664e"
      },
      "expo-navigation-bar": {
        "hidden": true
      }
    },
    "owner": "juanoffx"
  }
}
